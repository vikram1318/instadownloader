# ── Secrets (NEVER commit this file) ──────────────────────────
# Copy this file to .env and fill in your values

# A long random string used to sign Flask sessions
# Generate one: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string

# Password to access the web UI (leave blank to disable login)
APP_PASSWORD=your-strong-password-here

# Optional: path to a cookies.txt file for Instagram login
# COOKIES_FILE=/path/to/cookies.txt

# Port to run on (default 5050)
PORT=5050

# Max downloads allowed per IP per hour (rate limiting)
RATE_LIMIT=30

# Max parallel download workers allowed per job
MAX_WORKERS=10

# Auto-delete downloads older than N hours (0 = never)
CLEANUP_HOURS=24

# Set to "production" for deployment, "development" for local
FLASK_ENV=development

